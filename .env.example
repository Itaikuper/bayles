# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# WhatsApp Configuration
AUTH_DIR=./auth_info

# Bot Behavior
BOT_PREFIX=!ai

# AI System Prompt (customize as needed)
SYSTEM_PROMPT=You are a helpful and friendly WhatsApp assistant. Keep responses concise and conversational. Respond in the same language as the user.

# Dashboard API Server
API_PORT=3000

# Debug mode (optional)
DEBUG=false

# Gmail personal assistant (private, single owner JID)
# Leave blank to disable. To generate GMAIL_ENCRYPTION_KEY:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/oauth/callback
GMAIL_OWNER_JID=
GMAIL_ENCRYPTION_KEY=
GMAIL_POLL_CRON=*/7 * * * *
